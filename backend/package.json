{
  "scripts": {
    "typecheck": "tsc --watch",
    "devserver": "tsc && DEBUG=1 bun --hot run dist/index.js",
    "build": "bunx tsc",
    "start": "bun dist/index.js",
    "dev": "concurrently -k -n TSC,BUN -c yellow,cyan \"bun run build -- --watch\" \"bun run devserver\"",
    "prepare": "ts-patch install"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.2",
    "@simplewebauthn/types": "^12.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongodb": "^4.0.7",
    "@types/socket.io": "^3.0.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.13.0",
    "mongoose": "^8.10.1",
    "socket.io": "^4.8.3",
    "typia": "^12.1.1",
    "ua-parser-js": "^2.0.10"
  },
  "devDependencies": {
    "@types/ua-parser-js": "^0.7.39",
    "concurrently": "^10.0.3",
    "ts-patch": "^4.0.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@peculiar/asn1-schema": "2.8.0"
  }
}