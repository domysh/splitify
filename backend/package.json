{
  "scripts": {
    "typecheck": "tsc --watch",
    "devserver": "tsc && bunx prisma db push --accept-data-loss && DEBUG=1 bun --hot run dist/index.js",
    "build": "bunx tsc",
    "start": "bunx prisma db push --accept-data-loss && bun dist/index.js",
    "dev": "concurrently -k -n TSC,BUN -c yellow,cyan \"bun run build -- --watch\" \"bun run devserver\"",
    "test": "bunx tsc && bun test dist/tests",
    "prepare": "ts-patch install"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@simplewebauthn/server": "^13.3.2",
    "@simplewebauthn/types": "^12.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.20.0",
    "@types/socket.io": "^3.0.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "socket.io": "^4.8.3",
    "typia": "^12.1.1",
    "ua-parser-js": "^2.0.10"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.0",
    "@types/ua-parser-js": "^0.7.39",
    "bun-types": "^1.3.14",
    "concurrently": "^10.0.3",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "ts-patch": "^4.0.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@peculiar/asn1-schema": "2.8.0"
  }
}