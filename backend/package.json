{
  "scripts": {
    "typecheck": "tsc --watch",
    "devserver": "tsc && DEBUG=1 bun --hot run dist/index.js",
    "build": "bunx tsc",
    "start": "bun dist/index.js",
    "dev": "concurrently -k -n TSC,BUN -c yellow,cyan \"bun run build -- --watch\" \"bun run devserver\"",
    "prepare": "ts-patch install"
  },
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongodb": "^4.0.7",
    "@types/socket.io": "^3.0.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.0.0",
    "mongoose": "^9.1.5",
    "socket.io": "^4.8.3",
    "typia": "^11.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "ts-patch": "^3.3.0",
    "typescript": "~5.9.3"
  }
}